# Copy this file to .env and fill in the blanks. .env is never committed.

# Postgres from `docker compose up -d db`
DATABASE_URL=postgresql://bizwiz:bizwiz@localhost:5442/bizwiz

# Claude, for answers. Leave ANSWERER=claude to use the real model, or set it to `fake`
# to try the app without an API key (it quotes the best-matching document instead).
ANTHROPIC_API_KEY=
ANSWERER=claude
ANSWER_MODEL=claude-opus-5-5

# Where the web app runs (allowed to call the API)
WEB_ORIGIN=http://localhost:3010
